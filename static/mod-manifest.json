{
    "apiVersion": "2.2",
    "version": "2.0.0",
    "name": "Area chart",
    "id": "spotfire-area-chart-mod",
    "icon": "images/icon.svg",
    "type": "visualization",
    "properties": [
        {
            "name": "mod-config",
            "type": "string",
            "defaultValue": ""
        },
        {
            "name": "trellis",
            "type": "string",
            "defaultValue": "{\"scrollPageIndex\":0}"
        },
        {
            "name": "zoom",
            "type": "string",
            "defaultValue": ""
        }
    ],
    "dataViewDefinition": {
        "colorAxis": {
            "mode": "categorical",
            "dropTarget": {
                "icon": "Color",
                "description": "Color by {0}"
            }
        },
        "axes": [
            {
                "name": "Trellis by",
                "mode": "categorical",
                "placement": "none",
                "optional": true
            },
            {
                "name": "X",
                "mode": "categorical",
                "placement": "bottom",
                "dropTarget": {
                    "icon": "XAxis3D",
                    "description": "Use {0} on the mod's X-axis"
                },
                "propertyControl": {
                    "title": "X-axis"
                },
                "legendItem": {
                    "title": "X-axis",
                    "defaultVisibility": "hidden"
                }
            },
            {
                "name": "Y",
                "mode": "continuous",
                "allowMultipleMeasures": true,
                "placement": "left",
                "propertyControl": {
                    "title": "Y-axis"
                },
                "legendItem": {
                    "title": "Y-axis",
                    "defaultVisibility": "hidden"
                }
            }
        ],
        "tooltip": {
            "enabled": true
        }
    },
    "files": [
        "index.html",
        "main.css",
        "bundle.js"
    ]
}